{
  "name": "nuutapao-tools",
  "version": "3.1.1",
  "description": "Nuutapao Tools - Ultimate Media Downloader & Clipper",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "node --test test/app-state.test.js test/server-access.test.js",
    "test:api": "node --test test/server-endpoints.test.js test/server-runtime.test.js test/qr.test.js",
    "test:smoke": "node --test test/smoke-tools.test.js",
    "test:ui": "playwright test",
    "test:coverage": "c8 --check-coverage --lines 80 --functions 80 --exclude='test/**' --exclude='public/**' node --test test/app-state.test.js test/server-access.test.js test/server-endpoints.test.js test/server-runtime.test.js test/qr.test.js",
    "test:all": "npm run test && npm run test:smoke && npm run test:ui && npm run test:coverage",
    "build": "electron-builder --win --x64",
    "build:custom-setup": "node scripts/build-custom-installer.js",
    "package:source": "node scripts/package-github-source.js",
    "setup": "electron installer/main.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ffmpeg-static": "^5.2.0",
    "multer": "^2.2.0",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "c8": "^12.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nuutapao.tools",
    "productName": "Nuutapao Tools",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "app-state.js",
      "package.json",
      "icon.ico",
      "Nuutapao Human Head.png",
      "public/**",
      "!public/app/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nuutapao Tools",
      "include": "installer.nsh"
    },
    "extraResources": [
      {
        "from": "tools/yt-dlp.exe",
        "to": "tools/yt-dlp.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "tools/ffmpeg.exe"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "public/logo.png",
      "category": "public.app-category.utilities",
      "extraResources": [
        {
          "from": "tools/yt-dlp",
          "to": "tools/yt-dlp"
        },
        {
          "from": "node_modules/ffmpeg-static/ffmpeg",
          "to": "tools/ffmpeg"
        }
      ]
    }
  }
}
